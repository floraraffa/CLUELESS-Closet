  InputLines:
    - '// @input AssignableType narrator {"hint":"StyleNarrator script — used for the tutorial TTS voice"}'
    - '// @input AssignableType_1 cardInteraction {"hint":"CardInteraction script — polled to detect carousel rotation + grid gesture"}'
    - '// @input SceneObject tutorialPanel {"hint":"Optional root SceneObject for the tutorial text panel (shown during onboarding, hidden after)"}'
    - '// @input Component.Text tutorialText {"hint":"Text component that displays the current tutorial instruction (mirrors the spoken line)"}'
    - '// @input SceneObject skipButton {"hint":"\"Skip Tutorial\" button SceneObject"}'
    - '// @input Component.Text skipButtonText {"hint":"Text component of the Skip button label"}'
    - '// @input AssignableType_2 handHints {"hint":"Spectacles 3D Hand Hints — drag the object that has the InteractionHintController component. The tutorial plays the correct hand animation per step."}'
    - '// @input SceneObject pinchAnchor {"hint":"Anchor SceneObject for the Pinch hint — place it at/near the Scan button. Shown during the SCAN step."}'
    - '// @input SceneObject gestureAnchor {"hint":"Anchor SceneObject for gesture hints (the LEFT-wrist closet button, carousel, grid). Place an empty object where you want the hint to appear."}'
    - '// @input SceneObject languageAnchor {"hint":"Anchor SceneObject for the language step — place it near the flags / Accept button at the bottom of the Language Container. The pinch hint points here at launch."}'
    - '// @input SceneObject headCamera {"hint":"Head-tracked Camera SceneObject. Hints parent to this so they always appear in front of the user (at the per-step offset) no matter where the user stands. Used whenever a step has no specific anchor."}'
    - '// @input vec3 languageHintOffset = {0,0,-60} {"hint":"LANGUAGE step — hand-hint offset (cm) from the language anchor (toward the flags)."}'
    - '// @input vec3 scanHintOffset = {0,0,-60} {"hint":"SCAN step — hand-hint offset (cm) from the pinch anchor (Scan button)."}'
    - '// @input vec3 saveHintOffset = {0,0,-60} {"hint":"SAVE step — hand-hint offset (cm) from the pinch anchor (Save the look)."}'
    - '// @input vec3 closetHintOffset = {0,0,-60} {"hint":"CLOSET step — hand-hint offset (cm) from the gesture anchor (open the left-wrist closet)."}'
    - '// @input vec3 carouselHintOffset = {0,0,-60} {"hint":"CAROUSEL step — hand-hint offset (cm) from the gesture anchor."}'
    - '// @input vec3 gridHintOffset = {0,0,-60} {"hint":"GRID step — hand-hint offset (cm) from the gesture anchor."}'
    - '// @input float handHintSize = 0.5 {"hint":"Overall scale of the 3D hand hints. Lower = smaller. Applied every time a hint is shown.", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input bool alwaysShowTutorial {"hint":"DEBUG: always run the tutorial on launch, ignoring the saved \"completed\" flag."}'
    - '// @input bool debugStartLanguage {"hint":"DEBUG: on launch, jump straight to the LANGUAGE step."}'
    - '// @input bool debugStartScan {"hint":"DEBUG: on launch, jump straight to the SCAN step."}'
    - '// @input bool debugStartSave {"hint":"DEBUG: on launch, jump straight to the SAVE step."}'
    - '// @input bool debugStartCloset {"hint":"DEBUG: on launch, jump straight to the CLOSET step."}'
    - '// @input bool debugStartCarousel {"hint":"DEBUG: on launch, jump straight to the CAROUSEL step."}'
    - '// @input bool debugStartGrid {"hint":"DEBUG: on launch, jump straight to the GRID step."}'
    - '// @input Asset.Asset voiceMLModule {"hint":"VoiceML Module asset — enables the spoken \"Skip Tutorial\" command. Optional: the Skip button always works without it."}'
    - '// @input float carouselRotationThreshold = 0.35 {"hint":"Carousel rotation (radians) the user must reach to clear the CAROUSEL step"}'
